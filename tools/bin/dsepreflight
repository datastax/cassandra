# The preflight inspection of a DataStax Enterprise 6.8/6.9 node before its in-place upgrade to HCD 2.0.
# Read-only; runs from the unpacked HCD 2.0 tarball, DSE running or stopped. See --help.

# The environment of a DSE node may name DSE's own installation (CASSANDRA_HOME, CASSANDRA_CONF, CASSANDRA_INCLUDE) and
# DSE's JVM options (JVM_OPTS, JAVA_AGENT): the tool always runs with the jars and the configuration directory of the
# installation it comes with, and with none of those options. Run it from that installation, not through a link to it.
CASSANDRA_HOME="`dirname "$0"`/../.."
CASSANDRA_CONF="$CASSANDRA_HOME/conf"
JVM_OPTS=""
JAVA_AGENT=""
. "`dirname "$0"`/cassandra.in.sh"

if [ -z "$CLASSPATH" ]; then
    echo "You must set the CLASSPATH var" >&2
    exit 2
fi

if [ "x$MAX_HEAP_SIZE" = "x" ]; then
    MAX_HEAP_SIZE="512M"
fi

"$JAVA" $JAVA_AGENT -ea -cp "$CLASSPATH" $JVM_OPTS -Xmx$MAX_HEAP_SIZE \
        -Dcassandra.storagedir="$cassandra_storagedir" \
        -Dlogback.configurationFile=logback-tools.xml \
        org.apache.cassandra.tools.dsepreflight.DsePreflight "$@"

# vi:ai sw=4 ts=4 tw=0 et
