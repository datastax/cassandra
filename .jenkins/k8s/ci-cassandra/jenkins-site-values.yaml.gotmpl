#
# Site-specific values injected from environment variables.
# Rendered by helmfile's Go template engine before being passed to Helm.
#
# Required env var:
#   JENKINS_HOSTNAME  — public DNS name, e.g. ci-cassandra.infra.datastax.com
#
# This file is intentionally free of hostnames so it can be committed.
# The actual hostname comes from the JENKINS_HOSTNAME env var set in
# ~/bin/ci-datastax-deploy.sh (not checked in).

controller:
  # Sets unclassified.location.url in the chart's default JCasC config so
  # that Jenkins's root URL matches the public HTTPS address.  This suppresses
  # the "reverse proxy is broken" warning on the Manage Jenkins page and
  # ensures webhook callbacks and email links use the correct URL.
  #
  # controller.jenkinsUrl overrides the default (http://<svc>:<port>) that the
  # chart injects into jcasc-default-config.yaml.  Using this value (rather
  # than a separate configScripts entry) avoids JCasC's "conflicting
  # configuration" error that occurs when two config files set the same key.
  jenkinsUrl: "https://{{ requiredEnv `JENKINS_HOSTNAME` }}"
