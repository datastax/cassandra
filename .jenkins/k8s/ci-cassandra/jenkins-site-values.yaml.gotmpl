#
# Site-specific JCasC values injected from environment variables.
# Rendered by helmfile's Go template engine before being passed to Helm.
#
# Required env var:
#   JENKINS_HOSTNAME  — public DNS name, e.g. ci-cassandra.infra.datastax.com
#
# This file is intentionally free of hostnames so it can be committed.
# The actual hostname comes from the JENKINS_HOSTNAME env var set in
# ~/bin/ci-datastax-deploy.sh (not checked in).

controller:
  JCasC:
    configScripts:
      # Set the Jenkins root URL to the public HTTPS address so that:
      #   - The "reverse proxy is broken" warning is suppressed.
      #   - Webhook callbacks, email links, and build URLs are correct.
      #   - The Kubernetes cloud's jenkins URL stays on the internal service
      #     (set in jenkins-deployment.yaml) so agents can reach the controller
      #     without going through the public LB.
      site-url: |
        unclassified:
          location:
            url: "https://{{ requiredEnv "JENKINS_HOSTNAME" }}"
