<!-- Logging of org.apache.cassandra.harry.soak.SoakRunner, packaged as the logback.xml of build/harry-soak/harry-soak.jar.
     Without it logback logs everything at DEBUG, the driver's per-request chatter included. -->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%-5level [%thread] %date{"yyyy-MM-dd'T'HH:mm:ss,SSS", UTC} %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
